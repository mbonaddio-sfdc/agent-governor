# This file specifies intentionally untracked files that Git should ignore.
# For more information see: https://git-scm.com/docs/gitignore

# Salesforce cache
.sf/
.sfdx/
.localdevserver/
deploy-options.json

# VSCode
.vscode/*
!.vscode/extensions.json

# LWC VSCode autocomplete
**/lwc/jsconfig.json

# LWC Jest coverage reports
coverage/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Dependency directories
node_modules/

# ApexPMD cache
.pmdCache

# Eslint cache
.eslintcache

# Local environment variables
.env

# Python Salesforce Functions
**/__pycache__/
**/.venv/
**/venv/

# MacOS system files
.DS_Store
**/.DS_Store

# Windows system files
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# Editor noise
*.swp

# Internal working docs (kept locally, not published to the repo)
HARDENING_PLAN.md
