<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <!--
        Agent Governor - Release Team (Operator) permission set.

        Purpose: give release-team business users least-privilege access to TUNE the
        operational controls on an existing Agent Governor Configuration record, without
        the admin/deploy rights carried by the "Agent Governor" permission set.

        Grants:
          - Object Read + Edit (NO Create, NO Delete)  -> tune existing records only.
          - Read + Edit on the operator controls (Is_Active, Sampling_Rate, Daily_Limit,
            Start_Hour, End_Hour, Time_Zone, Exclude_Weekends).
          - Read-only on the system-managed fields (Current_Count, Is_Green, Reset_Date)
            so operators can see live state but cannot desync the throttle by editing it.
          - Read on Linked_Channel_ID for context.
          - Tab + app visibility so the record is reachable.

        Deliberately omits:
          - classAccesses: operators edit via the UI; they do not need the Apex engine
            classes enabled (those belong to the admin/deploy "Agent Governor" set).
          - Any fieldPermissions on Governor_Key__c: it is a REQUIRED field, and Salesforce
            rejects FLS on required fields. Access to it is governed by object-level Edit.
    -->
    <applicationVisibilities>
        <application>Agent_Governor</application>
        <visible>true</visible>
    </applicationVisibilities>
    <!-- Operator controls: Read + Edit -->
    <fieldPermissions>
        <editable>true</editable>
        <field>Agent_Governor_Configuration__c.Is_Active__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Agent_Governor_Configuration__c.Sampling_Rate__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Agent_Governor_Configuration__c.Daily_Limit__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Agent_Governor_Configuration__c.Start_Hour__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Agent_Governor_Configuration__c.End_Hour__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Agent_Governor_Configuration__c.Time_Zone__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Agent_Governor_Configuration__c.Exclude_Weekends__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <!-- Context field: Read-only -->
    <fieldPermissions>
        <editable>false</editable>
        <field>Agent_Governor_Configuration__c.Linked_Channel_ID__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <!-- System-managed fields: Read-only (see, but do not edit) -->
    <fieldPermissions>
        <editable>false</editable>
        <field>Agent_Governor_Configuration__c.Current_Count__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Agent_Governor_Configuration__c.Is_Green__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Agent_Governor_Configuration__c.Reset_Date__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <hasActivationRequired>false</hasActivationRequired>
    <label>Agent Governor - Release Team</label>
    <license>Salesforce</license>
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Agent_Governor_Configuration__c</object>
        <viewAllFields>false</viewAllFields>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <tabSettings>
        <tab>Agent_Governor_Configuration__c</tab>
        <visibility>Visible</visibility>
    </tabSettings>
</PermissionSet>
